<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{app_name}} - Forgot Password</title>
    {{!-- <link rel="stylesheet" href="{{css_file_path}}css2.css"> --}}
</head>
<style>
    .textContent{
       font-size: 14px; 
    }
</style>

<body style=" font-family: 'Montserrat' , sans-serif;">
    <table style="width: 100% ! important;background: #ffffff;" width="100% !important">
        <tr>
            <td>
                <table
                    style="padding: 35px 30px;"
                    width="100% !important" border="0" cellpadding="0" cellspacing="0">
                    <tbody>
                        <tr>
                            <td>
                                <table style="width: 500px;float: left;">
                                    <tr>
                                        <td>
                                            <img src="{{email_logo}}"
                                                style="width:15%;max-width:125px;max-height:100px;object-fit:cover;margin: -6px;">
                                            <p class="textContent">Hello {{name}},</p>
                                            <p class="textContent">You recently requested to reset your password for your {{app_name}} account.<br>Please enter the temporary password in the reset password screen when you login to your account.</p>
                                            <p class="textContent">Temporary Password: {{temp_password}}</p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <p class="textContent">Please note: If this account had another temporary password set previously,<br>this password is no longer valid.</p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</body>

</html>